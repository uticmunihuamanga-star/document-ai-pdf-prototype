# Variables de entorno para Docker Compose
# IMPORTANTE: NO SUBIR ESTE ARCHIVO A GIT CON LA API KEY REAL

# API Key de Google Gemini (REQUERIDO)
GOOGLE_API_KEYS=tus_apis_keys_aqui_separados_por_comas

# Modelo de IA a utilizar
AI_MODEL=gemini-2.5-flash-lite

# Configuración de logs
LOG_LEVEL=INFO

# Timeouts y reintentos
MAX_RETRIES=3
REQUEST_TIMEOUT=60

# Rutas (en Docker son automáticas, no es necesario configurarlas)
# Para uso local, descomenta las siguientes líneas y ajusta las rutas según tu sistema
TESSERACT_PATH=/usr/bin/tesseract
POPPLER_PATH=/usr/bin

# Supabase configuration (opcional, solo si usas Supabase)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-clave-anon-o-service-role"
SUPABASE_BUCKET="documentos"  # El nombre de tu bucket en Supabase